<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="cybergear_ros2_control" params="name canbus motor_type device_id kp kd joint_name axis_direction:=1">
    <ros2_control name="${name}" type="actuator">
        <hardware>
            <plugin>cybergear_control/CybergearActuator</plugin>
            <param name="can_interface">${canbus}</param>
            <param name="timeout_sec">3.0</param>
            <param name="interval_sec">0.01</param>
            <param name="motor_type">${motor_type}</param>
            <param name="device_id">${device_id}</param>
            <param name="primary_id">0</param>
            <param name="kp">${kp}</param>
            <param name="kd">${kd}</param>
            <param name="calibrate_on_activate">false</param>
            <param name="axis_direction">${axis_direction}</param>
        </hardware>
        <joint name="${joint_name}">
            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <command_interface name="kp"/>
            <command_interface name="kd"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
            <state_interface name="temperature"/>
        </joint>
    </ros2_control>
  </xacro:macro>
</robot>
